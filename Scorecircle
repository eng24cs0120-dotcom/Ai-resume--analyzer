import React from "react";
import { Card, CardContent } from "@/components/ui/card";
import { motion } from "framer-motion";

const getScoreColor = (score) => {
  if (score >= 80) return "from-emerald-500 to-emerald-600";
  if (score >= 60) return "from-amber-500 to-amber-600";
  return "from-red-500 to-red-600";
};

export default function ScoreCircle({ label, score, icon: Icon, delay }) {
  return (
    <motion.div
      initial={{ opacity: 0, scale: 0.8 }}
      animate={{ opacity: 1, scale: 1 }}
      transition={{ delay, type: "spring" }}
    >
      <Card className="border-none shadow-lg hover:shadow-xl transition-all duration-300 bg-white/80 backdrop-blur-sm">
        <CardContent className="p-6 text-center space-y-3">
          <div className="flex justify-center">
            <div className={`p-3 rounded-xl bg-gradient-to-br ${getScoreColor(score)} bg-opacity-10`}>
              <Icon className="w-6 h-6 text-slate-700" />
            </div>
          </div>
          <div>
            <p className={`text-3xl font-bold bg-gradient-to-br ${getScoreColor(score)} bg-clip-text text-transparent`}>
              {score}
            </p>
            <p className="text-sm text-slate-600 font-medium mt-1">{label}</p>
          </div>
        </CardContent>
      </Card>
    </motion.div>
  );
}
