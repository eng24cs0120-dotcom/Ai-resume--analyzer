
import React, { useState, useEffect, useCallback } from "react";
import { ArrowLeft, ArrowRight, Download, Eye } from "lucide-react";
import { Button } from "@/components/ui/button";
import { motion, AnimatePresence } from "framer-motion";
import Slide from "../components/presentation/Slide";
import Slide1_Title from "../components/presentation/slides/Slide1_Title";
import Slide2_Problem from "../components/presentation/slides/Slide2_Problem";
import Slide3_Solution from "../components/presentation/slides/Slide3_Solution";
import Slide4_HowItWorks from "../components/presentation/slides/Slide4_HowItWorks";
import Slide5_CoreFeatures from "../components/presentation/slides/Slide5_CoreFeatures";
import Slide6_Demo from "../components/presentation/slides/Slide6_Demo";
import Slide7_TechStack from "../components/presentation/slides/Slide7_TechStack";
import Slide8_BusinessModel from "../components/presentation/slides/Slide8_BusinessModel";
import Slide9_Roadmap from "../components/presentation/slides/Slide9_Roadmap";
import Slide10_ThankYou from "../components/presentation/slides/Slide10_ThankYou";

const slides = [
  Slide1_Title,
  Slide2_Problem,
  Slide3_Solution,
  Slide4_HowItWorks,
  Slide5_CoreFeatures,
  Slide6_Demo,
  Slide7_TechStack,
  Slide8_BusinessModel,
  Slide9_Roadmap,
  Slide10_ThankYou,
];

const slideVariants = {
  enter: (direction) => ({
    x: direction > 0 ? 1000 : -1000,
    opacity: 0,
  }),
  center: {
    zIndex: 1,
    x: 0,
    opacity: 1,
  },
  exit: (direction) => ({
    zIndex: 0,
    x: direction < 0 ? 1000 : -1000,
    opacity: 0,
  }),
};

export default function PresentationPage() {
  const [[page, direction], setPage] = useState([0, 0]);

  const paginate = useCallback((newDirection) => {
    setPage(([currentPage]) => {
        let newIndex = currentPage + newDirection;
        if (newIndex < 0) {
            newIndex = slides.length - 1;
        } else if (newIndex >= slides.length) {
            newIndex = 0;
        }
        return [newIndex, newDirection];
    });
  }, []); // Empty dependency array as slides.length is constant

  useEffect(() => {
    const handleKeyDown = (e) => {
      if (e.key === "ArrowRight") {
        paginate(1);
      } else if (e.key === "ArrowLeft") {
        paginate(-1);
      }
    };

    window.addEventListener("keydown", handleKeyDown);
    return () => {
      window.removeEventListener("keydown", handleKeyDown);
    };
  }, [paginate]); // 'paginate' is now stable due to useCallback

  const CurrentSlide = slides[page];

  return (
    <div className="relative w-full h-screen bg-slate-900 overflow-hidden flex flex-col items-center justify-center">
      <AnimatePresence initial={false} custom={direction}>
        <motion.div
          key={page}
          custom={direction}
          variants={slideVariants}
          initial="enter"
          animate="center"
          exit="exit"
          transition={{
            x: { type: "spring", stiffness: 300, damping: 30 },
            opacity: { duration: 0.2 },
          }}
          className="absolute w-full h-full"
        >
          <CurrentSlide slideNumber={page + 1} totalSlides={slides.length} />
        </motion.div>
      </AnimatePresence>

      {/* Navigation Controls */}
      <div className="absolute bottom-6 left-1/2 -translate-x-1/2 z-20 flex items-center gap-3 bg-black/30 backdrop-blur-sm p-2 rounded-xl">
        <Button
          variant="ghost"
          size="icon"
          onClick={() => paginate(-1)}
          className="text-white hover:bg-white/20 hover:text-white"
        >
          <ArrowLeft className="w-6 h-6" />
        </Button>
        <span className="text-white font-mono text-sm w-12 text-center">
          {page + 1} / {slides.length}
        </span>
        <Button
          variant="ghost"
          size="icon"
          onClick={() => paginate(1)}
          className="text-white hover:bg-white/20 hover:text-white"
        >
          <ArrowRight className="w-6 h-6" />
        </Button>
      </div>

       {/* Top Bar */}
       <div className="absolute top-0 left-0 right-0 p-4 z-20 flex justify-between items-center">
         <a href={window.location.origin} className="flex items-center gap-2 text-white font-bold text-lg">
            <Eye className="w-5 h-5"/>
            <span>Back to App</span>
         </a>
         <Button
           variant="outline"
           onClick={() => window.print()}
           className="bg-transparent text-white border-white/50 hover:bg-white hover:text-slate-900"
         >
           <Download className="w-4 h-4 mr-2" />
           Save as PDF
         </Button>
       </div>
       <style>{`
          @media print {
            body, html {
              background: #0f172a !important; /* slate-900 */
              -webkit-print-color-adjust: exact;
            }
            div[class*="absolute"] {
              display: none;
            }
          }
        `}</style>
    </div>
  );
}
