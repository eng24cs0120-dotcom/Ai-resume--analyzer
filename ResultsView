import React from "react";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Badge } from "@/components/ui/badge";
import { Award, TrendingUp, FileText, Target, Sparkles, Plus } from "lucide-react";
import { motion } from "framer-motion";

import ScoreCircle from "./ScoreCircle";
import SuggestionsList from "./SuggestionsList";

const getScoreColor = (score) => {
  if (score >= 80) return "from-emerald-500 to-emerald-600";
  if (score >= 60) return "from-amber-500 to-amber-600";
  return "from-red-500 to-red-600";
};

export default function ResultsView({ analysis, onNewAnalysis }) {
  return (
    <div className="space-y-6">
      {/* Header with Overall Score */}
      <Card className="border-none shadow-2xl bg-gradient-to-br from-indigo-50 via-purple-50 to-pink-50">
        <CardContent className="p-8">
          <div className="flex flex-col md:flex-row items-center justify-between gap-8">
            <div className="text-center md:text-left space-y-2">
              <h2 className="text-3xl md:text-4xl font-bold text-slate-900">
                {analysis.candidate_name || "Resume Analysis"}
              </h2>
              <div className="flex flex-wrap gap-2 justify-center md:justify-start">
                {analysis.target_role && (
                  <Badge className="bg-indigo-100 text-indigo-700 text-sm px-3 py-1">
                    <Target className="w-3 h-3 mr-1" />
                    {analysis.target_role}
                  </Badge>
                )}
                {analysis.years_of_experience && (
                  <Badge variant="outline" className="text-sm px-3 py-1">
                    {analysis.years_of_experience} years exp.
                  </Badge>
                )}
              </div>
            </div>
            
            <div className="relative">
              <motion.div
                initial={{ scale: 0 }}
                animate={{ scale: 1 }}
                transition={{ type: "spring", duration: 0.8 }}
              >
                <div className="relative">
                  <div className={`absolute inset-0 bg-gradient-to-br ${getScoreColor(analysis.overall_score)} rounded-full blur-2xl opacity-30 animate-pulse`} />
                  <div className="relative w-32 h-32 bg-white rounded-full flex items-center justify-center shadow-2xl">
                    <div className="text-center">
                      <p className="text-5xl font-bold bg-gradient-to-br from-indigo-600 to-purple-600 bg-clip-text text-transparent">
                        {analysis.overall_score}
                      </p>
                      <p className="text-xs text-slate-600 font-medium">Overall</p>
                    </div>
                  </div>
                </div>
              </motion.div>
            </div>
          </div>
        </CardContent>
      </Card>

      {/* Score Breakdown */}
      <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
        <ScoreCircle
          label="Skills"
          score={analysis.skills_score}
          icon={Award}
          delay={0.1}
        />
        <ScoreCircle
          label="Experience"
          score={analysis.experience_score}
          icon={TrendingUp}
          delay={0.2}
        />
        <ScoreCircle
          label="Formatting"
          score={analysis.formatting_score}
          icon={FileText}
          delay={0.3}
        />
        <ScoreCircle
          label="Impact"
          score={analysis.impact_score}
          icon={Sparkles}
          delay={0.4}
        />
      </div>

      {/* Strengths */}
      {analysis.strengths && analysis.strengths.length > 0 && (
        <Card className="border-none shadow-lg bg-white/80 backdrop-blur-sm">
          <CardHeader>
            <CardTitle className="flex items-center gap-2 text-xl">
              <Award className="w-6 h-6 text-emerald-600" />
              Key Strengths
            </CardTitle>
          </CardHeader>
          <CardContent>
            <div className="grid gap-3">
              {analysis.strengths.map((strength, index) => (
                <motion.div
                  key={index}
                  initial={{ opacity: 0, x: -20 }}
                  animate={{ opacity: 1, x: 0 }}
                  transition={{ delay: index * 0.1 }}
                  className="flex items-start gap-3 p-4 rounded-xl bg-emerald-50 border border-emerald-100"
                >
                  <div className="w-6 h-6 bg-emerald-500 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                    <span className="text-white text-sm font-bold">{index + 1}</span>
                  </div>
                  <p className="text-slate-700 leading-relaxed">{strength}</p>
                </motion.div>
              ))}
            </div>
          </CardContent>
        </Card>
      )}

      {/* Skills */}
      {analysis.extracted_skills && analysis.extracted_skills.length > 0 && (
        <Card className="border-none shadow-lg bg-white/80 backdrop-blur-sm">
          <CardHeader>
            <CardTitle className="text-xl">Extracted Skills</CardTitle>
          </CardHeader>
          <CardContent>
            <div className="flex flex-wrap gap-2">
              {analysis.extracted_skills.map((skill, index) => (
                <Badge
                  key={index}
                  variant="secondary"
                  className="px-4 py-2 text-sm bg-indigo-50 text-indigo-700 hover:bg-indigo-100"
                >
                  {skill}
                </Badge>
              ))}
            </div>
          </CardContent>
        </Card>
      )}

      {/* Suggestions */}
      <SuggestionsList suggestions={analysis.suggestions || []} />

      {/* Actions */}
      <div className="flex justify-center pt-4">
        <Button
          onClick={onNewAnalysis}
          size="lg"
          className="bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-700 hover:to-purple-700 shadow-lg hover:shadow-xl transition-all duration-300"
        >
          <Plus className="w-5 h-5 mr-2" />
          Analyze Another Resume
        </Button>
      </div>
    </div>
  );
}
